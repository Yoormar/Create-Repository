    display: block;
    margin-top: 3px;
    color: #475569;
    font-size: 11px;
    font-weight: 500;
  }
</style>

<script>
(function configurarDesplegableAlertasAsignacion() {
  if (window.__ALERTAS_ASIGNACION_DESPLEGABLE__) {
    return;
  }

  window.__ALERTAS_ASIGNACION_DESPLEGABLE__ = true;

  let alertasAsignacionAbiertas =
    sessionStorage.getItem(
      'alertasAsignacionAbiertas'
    ) === 'true';

  function aplicarEstadoAlertasAsignacion() {
    const contenido =
      document.getElementById(
        'alertasAsignacionDashboard'
      );

    const boton =
      document.getElementById(
        'botonToggleAlertasAsignacion'
      );

    const icono =
      document.getElementById(
        'iconoToggleAlertasAsignacion'
      );

    if (!contenido || !boton || !icono) {
      return;
    }

    contenido.classList.toggle(
      'oculto',
      !alertasAsignacionAbiertas
    );

    icono.textContent =
      alertasAsignacionAbiertas
        ? '▼'
        : '▶';

    boton.setAttribute(
      'aria-expanded',
      alertasAsignacionAbiertas
        ? 'true'
        : 'false'
    );
  }

  function prepararAlertasAsignacion() {
    const contenido =
      document.getElementById(
        'alertasAsignacionDashboard'
      );

    if (!contenido) {
      return;
    }

    const seccion =
      contenido.closest('section');

    const cabecera =
      seccion &&
      seccion.querySelector(
        '.titulo-panel-flex'
      );

    if (
      !cabecera ||
      document.getElementById(
        'botonToggleAlertasAsignacion'
      )
    ) {
      aplicarEstadoAlertasAsignacion();
      return;
    }

    const bloqueTitulo =
      cabecera.children[0];

    if (!bloqueTitulo) {
      return;
    }

    const boton =
      document.createElement('button');

    boton.id =
      'botonToggleAlertasAsignacion';

    boton.className =
      'boton-toggle-alertas-datos';

    boton.type = 'button';

    boton.setAttribute(
      'aria-expanded',
      'false'
    );

    boton.innerHTML = `
      <span id="iconoToggleAlertasAsignacion">
        ▶
      </span>

      <span>
        <strong>
          Alertas de asignación
        </strong>

        <small>
          Dos revisiones o combinación de revisión
          con atendido o seguimiento.
        </small>
      </span>
    `;

    boton.addEventListener(
      'click',
      function () {
        alertasAsignacionAbiertas =
          !alertasAsignacionAbiertas;

        sessionStorage.setItem(
          'alertasAsignacionAbiertas',
          String(
            alertasAsignacionAbiertas
          )
        );

        aplicarEstadoAlertasAsignacion();
      }
    );

    cabecera.replaceChild(
      boton,
      bloqueTitulo
    );

    aplicarEstadoAlertasAsignacion();
  }

  if (
    document.readyState === 'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      prepararAlertasAsignacion
    );
  } else {
    prepararAlertasAsignacion();
  }

  setTimeout(
    prepararAlertasAsignacion,
    800
  );
})();
</script>
